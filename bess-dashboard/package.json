{
  "name": "bess-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "SINGLEFILE=1 VITE_TILLAT_LOKALT=1 vite build --outDir dist-single",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:bevaka": "vitest",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:bilder": "playwright test skarmbilder --project=desktop",
    "e2e:rapport": "playwright show-report",
    "build:lokal": "VITE_TILLAT_LOKALT=1 vite build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/roboto-slab": "5.3.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/supabase-js": "^2.116.0",
    "dxf-parser": "1.1.2",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "lucide-react": "^1.47.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "web-ifc": "0.0.78"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^26.1.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
